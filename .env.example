DATABASE_URL=postgresql://user:password@localhost:5432/beauty_ecommerce?schema=public
# Used for metadataBase, sitemap.xml and robots.txt — set to the real
# production origin when deploying (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_VAPID_PUBLIC_KEY=generate-with-npx-web-push-generate-vapid-keys
VAPID_PRIVATE_KEY=generate-with-npx-web-push-generate-vapid-keys
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
IYZICO_API_KEY=your-sandbox-api-key
IYZICO_SECRET_KEY=your-sandbox-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
N8N_AUTOMATION_ENABLED=false
N8N_BASE_URL=https://n8n.example.com
N8N_ORDER_WEBHOOK_PATH=/webhook/order-created
N8N_CUSTOMER_REQUEST_WEBHOOK_PATH=/webhook/customer-request
N8N_LOW_STOCK_WEBHOOK_PATH=/webhook/low-stock
N8N_WEBHOOK_SECRET=replace-with-a-private-backend-to-n8n-secret
N8N_WEBHOOK_TIMEOUT_MS=3000
PENDING_ORDER_CLEANUP_HOURS=24
