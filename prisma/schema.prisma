// Owned data model for the store: product catalog, users/roles, orders,
// reviews, wishlist, coupons and push subscriptions. Replaces the
// DummyJSON-only catalog and the in-memory review/push stores that this
// project started with (see README "Üretim seviyesine taşıma" notes).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  HAZIRLANIYOR
  KARGOLANDI
  TESLIM_EDILDI
  IPTAL
  // Reachable only through the refund action (see src/lib/orders.ts
  // refundOrder) — a paid order returned after it shipped, money actually
  // sent back via iyzico. Distinct from IPTAL, which means "cancelled
  // before it ever shipped" and carries no such guarantee.
  IADE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String
  phone               String?
  birthDate           DateTime?
  role                Role                 @default(CUSTOMER)
  notifyMarketing     Boolean              @default(false)
  notifyOrderStatus   Boolean              @default(true)
  notifyNewProducts   Boolean              @default(false)
  notifySms           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  addresses           Address[]
  orders              Order[]
  wishlist            WishlistItem[]
  reviews             Review[]
  pushSubs            PushSubscription[]
  stockMovements      StockMovement[]
  orderEvents         OrderEvent[]
  passwordResetTokens PasswordResetToken[]
}

model Category {
  id              String     @id @default(cuid())
  slug            String     @unique
  label           String
  description     String?
  imageUrl        String?
  metaTitle       String?
  metaDescription String?
  position        Int        @default(0)
  parentId        String?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        Category[] @relation("CategoryHierarchy")
  products        Product[]
  campaigns       Campaign[]

  @@index([parentId])
}

model Brand {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  products  Product[]
  campaigns Campaign[]
}

// A reusable color swatch — named once, referenced by every variant that
// uses it, instead of each variant carrying its own free-text name/hex.
model Color {
  id        String           @id @default(cuid())
  name      String           @unique
  hex       String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  variants  ProductVariant[]
  images    ProductImage[]
}

// A named run of sizes (e.g. "Kadın Üst Giyim" = XS..XL, "Kadın Alt Giyim" =
// 34..42) — different product types use different groups, but sizes within
// a group share a position/order.
model SizeGroup {
  id         String      @id @default(cuid())
  name       String      @unique
  sizes      Size[]
  sizeCharts SizeChart[]
}

model Size {
  id            String           @id @default(cuid())
  sizeGroupId   String
  sizeGroup     SizeGroup        @relation(fields: [sizeGroupId], references: [id], onDelete: Cascade)
  label         String
  position      Int              @default(0)
  variants      ProductVariant[]
  sizeChartRows SizeChartRow[]

  @@unique([sizeGroupId, label])
  @@index([sizeGroupId])
}

// A measurement grid (rows = sizes, columns = body measurements in cm/inch)
// tied to one SizeGroup; a product opts in via Product.sizeChartId and one
// chart can be reused across many products of the same size group.
model SizeChart {
  id          String         @id @default(cuid())
  name        String
  sizeGroupId String
  sizeGroup   SizeGroup      @relation(fields: [sizeGroupId], references: [id])
  unit        String         @default("cm")
  columns     String[]
  rows        SizeChartRow[]
  products    Product[]
  createdAt   DateTime       @default(now())

  @@index([sizeGroupId])
}

model SizeChartRow {
  id           String    @id @default(cuid())
  sizeChartId  String
  sizeChart    SizeChart @relation(fields: [sizeChartId], references: [id], onDelete: Cascade)
  sizeId       String
  size         Size      @relation(fields: [sizeId], references: [id])
  measurements Json

  @@unique([sizeChartId, sizeId])
  @@index([sizeChartId])
}

// One row per fully-specified combination (color + size) — not a multi-axis
// matrix computed on the fly. Opt-in per product; a product with zero
// variants behaves exactly as before this model existed.
model ProductVariant {
  id                String   @id @default(cuid())
  productId         Int
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId           String
  color             Color    @relation(fields: [colorId], references: [id])
  sizeId            String
  size              Size     @relation(fields: [sizeId], references: [id])
  sku               String   @unique
  stock             Int      @default(0)
  priceOverride     Decimal? @db.Decimal(10, 2)
  // Overrides Product.lowStockThreshold for this variant when set; null
  // means "inherit the product's threshold" (see Bölüm 11 of the PRD).
  lowStockThreshold Int?
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orderItems     OrderItem[]
  wishlistedBy   WishlistItem[]
  stockMovements StockMovement[]

  @@index([productId])
  @@index([colorId])
  @@index([sizeId])
}

enum StockMovementType {
  RECEIVING
  SALE
  CANCELLATION
  RETURN
  DAMAGE
  MANUAL_ADJUSTMENT
  // Stock set aside when checkout starts (see src/lib/stock-reservation.ts);
  // becomes SALE once paid, or is undone by a RESERVATION_RELEASE.
  RESERVATION
  RESERVATION_RELEASE
}

// Append-only ledger — every change to Product.stock / ProductVariant.stock
// is expected to write one of these alongside the update, in the same
// transaction. Never edited or deleted after creation.
model StockMovement {
  id            String            @id @default(cuid())
  productId     Int
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant?   @relation(fields: [variantId], references: [id])
  type          StockMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  userId        String?
  user          User?             @relation(fields: [userId], references: [id])
  // The order behind a sale/reservation/release, when there is one. Kept
  // (as null) if a never-paid order is later deleted.
  orderId       String?
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime          @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([orderId])
  @@index([createdAt])
}

// Automatic (no-code) percentage-off promotion, scoped by exactly one of
// category / brand / minimum-spend (enforced at the API layer, not the DB —
// same app-level-not-DB-level pattern already used for Address.type).
model Campaign {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  discountPercentage Decimal   @db.Decimal(5, 2)
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id])
  brandId            String?
  brand              Brand?    @relation(fields: [brandId], references: [id])
  minSpend           Decimal?  @db.Decimal(10, 2)
  startAt            DateTime
  endAt              DateTime
  active             Boolean   @default(true)
  orders             Order[]
  createdAt          DateTime  @default(now())
}

model Collection {
  id          String              @id @default(cuid())
  slug        String              @unique
  label       String
  description String?
  active      Boolean             @default(true)
  // Optional window for seasonal collections — outside it the collection is
  // just marked expired in the admin, never auto-deleted (see Bölüm 14).
  startAt     DateTime?
  endAt       DateTime?
  products    ProductCollection[]
  createdAt   DateTime            @default(now())
}

// Join table for the Product <-> Collection many-to-many (a product can be
// featured in several curated collections, e.g. "Altın Işıltısı Serisi").
model ProductCollection {
  productId    Int
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
}

model Product {
  id                 Int                 @id
  title              String
  description        String
  // Admin-entered raw facts (kumaş, kalıp, bakım…), never shown to
  // customers. AI drafts are written from these, not from `description`,
  // so approving an AI description can't erase the facts it was based on.
  facts              String?
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id])
  price              Decimal             @db.Decimal(10, 2)
  discountPercentage Decimal             @default(0) @db.Decimal(5, 2)
  // Cost and tax feed the profit-margin figures shown in the admin — always
  // computed live from these, never stored (see Bölüm 9 of the PRD).
  cost               Decimal?            @db.Decimal(10, 2)
  taxRate            Decimal             @default(20) @db.Decimal(5, 2)
  stock              Int                 @default(0)
  lowStockThreshold  Int                 @default(10)
  brandId            String?
  brand              Brand?              @relation(fields: [brandId], references: [id])
  sizeChartId        String?
  sizeChart          SizeChart?          @relation(fields: [sizeChartId], references: [id])
  tags               String[]
  ratingAvg          Decimal             @default(0) @db.Decimal(3, 2)
  ratingCount        Int                 @default(0)
  isNew              Boolean             @default(false)
  thumbnail          String
  images             ProductImage[]
  reviews            Review[]
  wishlistedBy       WishlistItem[]
  orderItems         OrderItem[]
  collections        ProductCollection[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Cosmetic-specific attributes
  status            ProductStatus       @default(ACTIVE)
  skinTypes         String[]            @default([])
  skinConcerns      String[]            @default([])
  finish            String?
  coverage          String?
  texture           String?
  usagePurpose      String?
  // Shown on the product page under "İçerik & Bakım" — the fabric
  // composition and care instructions. (Column names are from the
  // cosmetics template this schema started as.)
  fullIngredients   String?
  usageInstructions String?
  warnings          String?
  isVegan           Boolean             @default(false)
  isCrueltyFree     Boolean             @default(false)
  isParabenFree     Boolean             @default(false)
  spf               Int?
  volumeLabel       String?
  origin            String?
  expiryInfo        String?
  metaTitle         String?
  metaDescription   String?
  variants          ProductVariant[]
  stockMovements    StockMovement[]
  contentDrafts     ContentDraft[]
  // Search also uses a trigram index on search_text(title, description),
  // created in the catalog_search migration (Prisma can't express it).

  @@index([categoryId])
  @@index([title])
  // Storefront listings always filter on ACTIVE within a category.
  @@index([status, categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)
  // Ties this photo to one color's variant gallery (e.g. the black product
  // shots) — null means it's a general/shared photo shown regardless of
  // which color the customer has selected.
  colorId   String?
  color     Color?  @relation(fields: [colorId], references: [id])

  @@index([productId])
  @@index([colorId])
}

model Review {
  id        String       @id @default(cuid())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  author    String
  rating    Int
  comment   String
  verified  Boolean      @default(false)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([productId, status])
}

model Address {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  // Default/label for the account address book — not a hard restriction on
  // which slot an address can fill at checkout (a shipping-labeled address
  // can still be reused as an order's billing address, and vice versa).
  type              AddressType @default(SHIPPING)
  label             String?
  fullName          String
  phone             String
  line1             String
  line2             String?
  city              String
  district          String
  postalCode        String
  // Independent of `type` on purpose (see note above) — an address can be
  // the default for shipping, billing, both, or neither.
  isDefaultShipping Boolean     @default(false)
  isDefaultBilling  Boolean     @default(false)
  shippingOrders    Order[]     @relation("ShippingAddress")
  billingOrders     Order[]     @relation("BillingAddress")

  @@index([userId])
}

model Order {
  id                     String          @id @default(cuid())
  orderNumber            String          @unique
  userId                 String
  user                   User            @relation(fields: [userId], references: [id])
  shippingAddressId      String
  shippingAddress        Address         @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId       String
  billingAddress         Address         @relation("BillingAddress", fields: [billingAddressId], references: [id])
  status                 OrderStatus     @default(PENDING_PAYMENT)
  subtotal               Decimal         @db.Decimal(10, 2)
  discountTotal          Decimal         @default(0) @db.Decimal(10, 2)
  shippingCost           Decimal         @default(0) @db.Decimal(10, 2)
  // VAT on the shipping fee (a service), frozen at checkout.
  shippingTaxRate        Decimal         @default(20) @db.Decimal(5, 2)
  total                  Decimal         @db.Decimal(10, 2)
  couponId               String?
  coupon                 Coupon?         @relation(fields: [couponId], references: [id])
  iyzicoPaymentId        String?
  iyzicoConversationId   String?         @unique
  iyzicoToken            String?         @unique
  // Captured at payment confirmation from CF-Retrieve's itemTransactions —
  // a refund is issued per transaction, not against the top-level payment,
  // so this is what refundOrder() actually has to work with later.
  iyzicoItemTransactions Json?
  paidAt                 DateTime?
  refundedAt             DateTime?
  // Stock is reserved when checkout starts and held until this time (the
  // iyzico payment page's own lifetime). Null on orders from before
  // reservations existed — those never held stock.
  reservedUntil          DateTime?
  // Set when a held reservation was given back (payment failed, expired or
  // the order was cancelled before payment).
  stockReleasedAt        DateTime?
  items                  OrderItem[]
  stockMovements         StockMovement[]
  shipments              Shipment[]
  invoices               Invoice[]
  emails                 EmailMessage[]
  internalNote           String?
  campaignId             String?
  campaign               Campaign?       @relation(fields: [campaignId], references: [id])
  events                 OrderEvent[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

// Append-only history of what happened to an order and when — backs the
// Sipariş Timeline (Bölüm 19). Distinct from a full system Audit Log
// (Bölüm 34): this is only the story of one order, shown to admins and
// (in simplified form) to the customer. actorUserId is null for
// system-triggered events (payment webhook, automated flows).
model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String
  message     String
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  sku            String?
  title          String
  thumbnail      String
  unitPrice      Decimal         @db.Decimal(10, 2)
  quantity       Int
  // Frozen at checkout for the invoice (src/lib/invoicing): the product's
  // VAT rate then, and this line's VAT-inclusive share of the order
  // discount (a campaign only covers some lines, a coupon all of them).
  taxRate        Decimal         @default(20) @db.Decimal(5, 2)
  discountAmount Decimal         @default(0) @db.Decimal(10, 2)
  invoiceLines   InvoiceLine[]
  // Set once this line's share of the order has been refunded (Bölüm 28 —
  // Kısmi İade). iyzico's refund granularity is per basket item, and
  // checkout/create keys basket items by productId — so lines sharing a
  // productId (e.g. two variants of the same product) share one iyzico
  // transaction and are always refunded together as a group.
  refundedAt     DateTime?
  // Optional free-form reason captured from the admin at refund time (Bölüm
  // 28 follow-up — İadeler reporting page). Nullable since it's opt-in and
  // refunds made before this field existed have none.
  refundReason   String?

  @@index([orderId])
}

model WishlistItem {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  productId  Int
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  createdAt  DateTime        @default(now())
  // Effective (discounted) unit price at the moment this was wishlisted —
  // captured once, never recomputed — so the account favorites page can
  // honestly show a "Fiyat Düştü" badge instead of guessing at a comparison.
  priceAtAdd Decimal?        @db.Decimal(10, 2)

  @@unique([userId, productId, variantId])
}

model Coupon {
  id         String     @id @default(cuid())
  code       String     @unique
  type       CouponType
  value      Decimal    @db.Decimal(10, 2)
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int        @default(0)
  active     Boolean    @default(true)
  orders     Order[]
  createdAt  DateTime   @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Single global config row, always read/written at the fixed id "global" —
// never a per-tenant table (Bölüm 40). Only covers values whose every
// consumer is a server component today (VIP tier math, the new-product
// form's prefilled threshold); shipping-cost constants stay in
// src/lib/shipping.ts since client components read those directly and
// making them dynamic would need prop-threading beyond this slice's scope.
model Settings {
  id                       String   @id @default("global")
  vipSpendThreshold        Decimal  @default(5000) @db.Decimal(10, 2)
  defaultLowStockThreshold Int      @default(10)
  updatedAt                DateTime @updatedAt
}

enum ContentDraftKind {
  SHORT_DESCRIPTION
  META_DESCRIPTION
  META_TITLE
  IMAGE_ALT
}

enum ContentDraftStatus {
  PENDING
  APPROVED
  REJECTED
}

// One AI-written text suggestion for a product field. Never written to the
// product on its own — only an admin's approval copies finalText over. Keeps
// both the raw AI text and what the admin actually approved (plus timing) so
// we can see which drafts get rewritten and how much time they save.
model ContentDraft {
  id           String             @id @default(cuid())
  productId    Int
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind         ContentDraftKind
  // IMAGE_ALT only: which photo the alt text is for. Keyed by URL because
  // product images are recreated (new ids) on every product save.
  imageUrl     String?
  status       ContentDraftStatus @default(PENDING)
  aiText       String
  finalText    String?
  // Product data the draft was generated from, for later review.
  input        Json
  model        String
  latencyMs    Int
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime           @default(now())
  decidedAt    DateTime?

  @@index([productId])
}

// Where a shipment is in its journey. PICKED_UP onward moves the order to
// KARGOLANDI, DELIVERED to TESLIM_EDILDI (see src/lib/shipping/events.ts).
enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  DELIVERED
}

// One parcel of an order, with the carrier's tracking number. The tracking
// number lives only here — the order has no copy of its own.
model Shipment {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Code from src/lib/shipping/carriers.ts ("yurtici", "simulator", …).
  carrier        String
  trackingNumber String
  status         ShipmentStatus  @default(CREATED)
  deliveredAt    DateTime?
  events         ShipmentEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([carrier, trackingNumber])
  @@index([orderId])
}

// A tracking scan, from a carrier webhook or entered by an admin.
// externalId is the carrier's own event id: a redelivered webhook hits the
// unique constraint and is ignored instead of being recorded twice.
model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  externalId  String
  status      ShipmentStatus
  description String
  location    String?
  occurredAt  DateTime
  createdAt   DateTime       @default(now())

  @@unique([shipmentId, externalId])
  @@index([shipmentId])
}

enum InvoiceType {
  SALE
  // Credit for returned lines, pointing at the sale invoice it reverses.
  RETURN
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

// An issued invoice is a legal record: its number, buyer, lines and totals
// never change and it is never deleted — the database enforces that (see
// the invoices migration). Mistakes are cancelled; returns get a RETURN
// document. Amounts are VAT-inclusive-derived, see src/lib/invoicing/tax.ts.
model Invoice {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type              InvoiceType
  status            InvoiceStatus @default(ISSUED)
  // e-Arşiv format: 3-letter prefix + year + 9-digit gapless sequence.
  number            String        @unique
  // ETTN: the document's universal id (UUID) on the e-Arşiv system, printed
  // on the invoice next to the number.
  ettn              String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issuedAt          DateTime      @default(now())
  cancelledAt       DateTime?
  cancelReason      String?
  // The buyer as invoiced (a later address change doesn't rewrite it).
  buyerName         String
  buyerIdentity     String
  buyerAddress      String
  buyerEmail        String
  netTotal          Decimal       @db.Decimal(12, 2)
  vatTotal          Decimal       @db.Decimal(12, 2)
  grandTotal        Decimal       @db.Decimal(12, 2)
  // Which e-invoice provider issued it, and its reference there.
  provider          String
  providerRef       String?
  originalInvoiceId String?
  originalInvoice   Invoice?      @relation("InvoiceReturns", fields: [originalInvoiceId], references: [id], onDelete: Restrict)
  returns           Invoice[]     @relation("InvoiceReturns")
  lines             InvoiceLine[]
  createdAt         DateTime      @default(now())

  @@index([orderId])
}

model InvoiceLine {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  // Null for the shipping line.
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  position    Int
  description String
  quantity    Int
  vatRate     Decimal    @db.Decimal(5, 2)
  unitPrice   Decimal    @db.Decimal(12, 2)
  discount    Decimal    @db.Decimal(12, 2)
  gross       Decimal    @db.Decimal(12, 2)
  net         Decimal    @db.Decimal(12, 2)
  vat         Decimal    @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([orderItemId])
}

// Last number used per series+year ("EDA2026"). Incremented in the same
// transaction as the invoice it numbers, so numbers are unique and — as
// rolled-back invoices roll their increment back too — gapless.
model InvoiceSequence {
  series     String @id
  lastNumber Int    @default(0)
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

// Transactional email outbox. A message is written in the same transaction
// as the change it reports (payment confirmed, shipped, refunded…), then
// delivered after commit; failures are retried by
// scripts/deliver-emails.ts. dedupeKey makes each notification happen once
// even when its trigger repeats (a carrier re-sending a webhook). SKIPPED:
// recorded but deliberately not sent (no provider configured, or the
// public demo, which never mails visitor-entered addresses).
model EmailMessage {
  id            String      @id @default(cuid())
  dedupeKey     String      @unique
  template      String
  to            String
  subject       String
  html          String
  text          String
  orderId       String?
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status        EmailStatus @default(QUEUED)
  attempts      Int         @default(0)
  // With SENDING: a delivery that died mid-send is retried after a while.
  lastAttemptAt DateTime?
  lastError     String?
  provider      String?
  providerRef   String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([status, createdAt])
  @@index([orderId])
}

// "Şifremi unuttum". Only a SHA-256 of the emailed token is stored, so a
// database leak doesn't hand out working reset links. Single use, short
// lived; usedAt is set in the same statement that checks it's still unused.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Payments taken by the built-in payment simulator (src/lib/payment-
// simulator.ts), which stands in for iyzico when no iyzico keys are set —
// the public demo. One row per checkout: what was asked for, what the
// buyer chose on the simulated payment page, and what was refunded.
model SimulatedPayment {
  token          String    @id
  paymentId      String    @unique
  conversationId String
  basketId       String
  price          Decimal   @db.Decimal(12, 2)
  paidPrice      Decimal   @db.Decimal(12, 2)
  // [{ id, name, price }] as sent to iyzico's checkout form.
  basketItems    Json
  outcome        String? // SUCCESS | FAILURE, once the buyer has chosen
  // { [paymentTransactionId]: refunded amount so far }
  refunds        Json      @default("{}")
  callbackUrl    String
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}
